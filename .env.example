# Flask
SECRET_KEY=change-this-to-something-random
FLASK_ENV=development
DATABASE_URL=sqlite:///mgr.db
FRONTEND_URL=http://localhost:5500

# Flutterwave (dashboard.flutterwave.com -> Settings -> API)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
# The hash/secret you set in Flutterwave's webhook settings — used to verify incoming webhooks
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-secret-hash

# Coinbase Commerce (commerce.coinbase.com -> Settings -> API keys)
COINBASE_COMMERCE_API_KEY=xxxxxxxx
COINBASE_COMMERCE_WEBHOOK_SECRET=xxxxxxxx

# Email notifications to the developer (any SMTP provider works — Gmail
# needs an "app password", not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFY_EMAIL=mdmasterdan@gmail.com

# File storage — Cloudinary (cloudinary.com, free tier is plenty to start)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Sheets live sync — see sheets.py for the one-time setup steps
GOOGLE_SHEET_ID=the-long-id-from-your-sheets-url
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
